# Vercel Environment Variables
# Add these variables in: Vercel Dashboard -> Project -> Settings -> Environment Variables

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=super_secret_portfolio_key_123_abc_xyz

# Initial Admin Credentials (used on first initialization)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
